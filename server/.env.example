PORT=4000
NODE_ENV=development

# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/our-little-world)
MONGODB_URI=

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLIENT_ORIGIN=http://localhost:5173

# Media storage: "local" (dev, saves to server/uploads) or "cloudinary"
MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The two accounts. Run `npm run seed` after filling these in.
SEED_ME_EMAIL=
SEED_ME_PASSWORD=
SEED_ME_NAME=
SEED_HER_EMAIL=
SEED_HER_PASSWORD=
SEED_HER_NAME=

# The date you count "days together" from (YYYY-MM-DD)
ANCHOR_DATE=
